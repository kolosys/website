{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "clean": {
      "cache": false
    },
    "db:dev": {
      "cache": false,
      "interactive": true,
      "dependsOn": ["^db:dev"]
    },
    "db:migrate": {
      "cache": false,
      "interactive": true,
      "dependsOn": ["^db:migrate"]
    }
  }
}
